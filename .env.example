# Copy to .env.local and fill in.

# Public base URL (used for the Google OAuth redirect). Defaults to the request origin.
APP_URL=http://localhost:3000

# Google sign-in (optional). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that get admin access (order management at /admin).
ADMIN_EMAILS=

# Used by `npm run db:admin` to create an admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: custom SQLite file location.
# DATABASE_PATH=./data/medicare.db

# Android test build download link shown on /app (defaults to the GitHub release).
# ANDROID_APK_URL=
